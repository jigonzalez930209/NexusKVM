[Unit]
Description=NexusKVM privileged input daemon
After=network.target
Before=display-manager.service

[Service]
Type=simple
# Input daemon needs /dev/input + /dev/uinput; run as root with primary group
# `input` so the desktop user can reach the control socket.
Group=input
UMask=0007
ExecStart=/usr/libexec/nexuskvm/nexus-kvmd --config /var/lib/nexuskvm/daemon.toml
Restart=always
RestartSec=2
# Kernel-level latency controls for the input path.
LimitRTPRIO=90
LimitNICE=-20
LimitMEMLOCK=infinity
RuntimeDirectory=nexuskvm
RuntimeDirectoryMode=0770
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/nexuskvm /var/lib/nexuskvm

[Install]
WantedBy=multi-user.target
