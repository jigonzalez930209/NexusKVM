{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "tray-panel-capability",
  "description": "Permissions for the quick tray panel window",
  "windows": ["tray-panel"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible"
  ]
}
