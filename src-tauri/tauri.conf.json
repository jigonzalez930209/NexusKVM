{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusKVM",
  "version": "0.1.0",
  "identifier": "io.nexuskvm.app",
  "build": {
    "beforeDevCommand": "bash scripts/build-runtime-bins.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build-runtime-bins.sh --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexusKVM",
        "label": "main",
        "width": 1240,
        "height": 780,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "visible": true
      },
      {
        "title": "NexusKVM Quick Panel",
        "label": "tray-panel",
        "width": 360,
        "height": 560,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Spatial KVM for Linux",
    "longDescription": "Share keyboard and mouse between Linux PCs. The app generates certificates and starts the daemon or client automatically.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/nexus-kvmd",
      "binaries/nexus-agent",
      "binaries/nexusctl",
      "binaries/rkvm-client"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openssl",
          "libevdev2",
          "kmod",
          "pkexec",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-nexuskvm-uinput.rules": "../udev/70-nexuskvm-desktop.rules",
          "/etc/modules-load.d/nexuskvm-uinput.conf": "../packaging/nexuskvm-uinput.conf",
          "/usr/share/doc/nexuskvm/POSTINSTALL.txt": "../packaging/POSTINSTALL.txt",
          "/usr/lib/systemd/system/nexuskvm-host.service": "../systemd/nexuskvm-host.service",
          "/usr/lib/systemd/system/nexuskvm-client.service": "../systemd/nexuskvm-client.service",
          "/usr/libexec/nexuskvm/nexuskvm-enable-boot.sh": "../scripts/nexuskvm-enable-boot.sh"
        },
        "postInstallScript": "../scripts/deb-postinst.sh"
      }
    }
  }
}
